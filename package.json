{
  "name": "@warm/icons",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plan-icons": {
      "types": "./dist/plan-icons.d.ts",
      "import": "./dist/plan-icons.js"
    },
    "./nucleo/generated-icons": {
      "types": "./dist/nucleo/generated-icons.d.ts",
      "import": "./dist/nucleo/generated-icons.js"
    },
    "./nucleo/icons/*": {
      "types": "./dist/nucleo/icons/*.d.ts",
      "import": "./dist/nucleo/icons/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  }
}
